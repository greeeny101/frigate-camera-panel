{
  "name": "frigate-camera-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "HA_WWW=../doorbell-panel/ha-config/www/frigate-camera-panel vite build --watch",
    "build": "vite build",
    "build:www": "HA_WWW=../doorbell-panel/ha-config/www/frigate-camera-panel vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": ".venv/bin/python -m pytest python-tests -q",
    "integration:dev": "vite build && rsync -a --delete --exclude __pycache__ custom_components/frigate_camera_panel/ ../doorbell-panel/ha-config/custom_components/frigate_camera_panel/"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
